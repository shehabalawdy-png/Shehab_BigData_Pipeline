# Core routing/loading
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=5000
SAMPLE_ROWS=100000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=shehab_bigdata
MONGO_CONNECT_TIMEOUT_MS=5000

# Spark
SPARK_MASTER=local[*]
SPARK_ELT_MASTER=local[2]
SPARK_ELT_SHUFFLE_PARTITIONS=64
SPARK_LOG_LEVEL=ERROR
# Optional path overrides:
# SPARK_TEMP_DIR=D:\SparkTemp
# SPARK_WAREHOUSE_DIR=D:\SparkWarehouse

# Final Spark stability settings
SPARK_DRIVER_MEMORY=4g
SPARK_DRIVER_HOST=127.0.0.1
SPARK_DRIVER_BIND_ADDRESS=127.0.0.1
SPARK_CACHE_BATCH_SIZE=256

# ============================================================
# Phase 2 - Final Project Additions
# ============================================================

# Phase 2 reuses the MongoDB settings above.
# FastAPI:
# python -m uvicorn src.phase2.api:app --host 127.0.0.1 --port 8000
# Swagger:
# http://127.0.0.1:8000/docs
# Scheduler:
# python -m src.phase2.scheduler
# Scheduler timezone: UTC
